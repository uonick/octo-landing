---
import SectionHeading from '@/components/section-heading.astro'
import ToneChip from '@/components/tone-chip.astro'
import { toneAt } from '@/lib/tone'

type Feature = {
  title: string
  description: string
  icon: string
}

const features: Feature[] = [
  {
    title: 'Несколько клиентов',
    description:
      'Несколько клиентов в одном окне: статус работ, долги, заметки. Удобно дизайнерам, разработчикам и всем, кто ведёт проекты на фрилансе',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  },
  {
    title: 'Счета и акты',
    description:
      'Счёт и акт из приложения, без шаблонов из интернета и платных сервисов. Подойдёт и самозанятому, и фрилансеру с несколькими клиентами',
    icon: 'M9 12h6m-6 4h6m-7 5h8a2 2 0 002-2V7.914a2 2 0 00-.586-1.414l-3.914-3.914A2 2 0 0011.086 2H6a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'Время работы',
    description:
      'Считайте часы по проектам и клиентам. Учёт времени привязан к делу, а не к отдельному таймеру где-то в телефоне',
    icon: 'M12 6v6l4 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Локальная база данных',
    description:
      'Данные только на вашем компьютере. Никуда не утекают, облако для хранения не нужно',
    icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 3.75c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
  },
  {
    title: 'Автономность',
    description:
      'Работает без интернета, когда сеть отвалилась или вы просто не хотите синхронизацию в облако',
    icon: 'M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12m6.894 5.785l-1.149-.964M6.256 7.178l-1.15-.964m15.352 8.864l-1.41-.513M4.954 9.435l-1.41-.514M12.002 12l-3.75 6.495',
  },
  {
    title: 'Уведомления',
    description: 'Напомнит об оплате счёта или дедлайне, чтобы не держать всё в голове',
    icon: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0',
  },
]
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-5">
  <SectionHeading eyebrow="Возможности" title="Учёт клиентов, времени и счетов">
    Видно, кто сколько должен и сколько часов ушло в проект. На вашем компьютере, офлайн.
  </SectionHeading>

  <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
    {
      features.map((feature, index) => (
        <li class="space-y-3 border-t border-line pt-6">
          <div class="flex items-center gap-3">
            <ToneChip tone={toneAt(index)}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-4"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
              </svg>
            </ToneChip>
            <h3 class="text-base font-semibold text-ink">{feature.title}</h3>
          </div>
          <p class="text-sm leading-relaxed text-ink-2">{feature.description}</p>
        </li>
      ))
    }
  </ul>
</section>
