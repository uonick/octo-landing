---
import { Image } from 'astro:assets'
import clientDark from '@/assets/images/client-dark.png'
import clientLight from '@/assets/images/client-light.png'
import discoverDark from '@/assets/images/discover-dark.png'
import discoverLight from '@/assets/images/discover-light.png'
import projectsDark from '@/assets/images/projects-dark.png'
import projectsLight from '@/assets/images/projects-light.png'
import tasksDark from '@/assets/images/tasks-dark.png'
import tasksLight from '@/assets/images/tasks-light.png'
import plannerDark from '@/assets/images/planner-dark.png'
import plannerLight from '@/assets/images/planner-light.png'
import invoiceDark from '@/assets/images/invoice-dark.png'
import invoiceLight from '@/assets/images/invoice-light.png'
import DownloadButtons from '@/components/download-buttons.astro'
import { getVersion } from '@/lib/download-links'

type Preview = {
  id: string
  label: string
  light: ImageMetadata
  dark: ImageMetadata
  altLight: string
  altDark: string
}

const previews: Preview[] = [
  {
    id: 'discover',
    label: 'Обзор',
    light: discoverLight,
    dark: discoverDark,
    altLight: 'Обзор в OctoWorkspace — светлая тема',
    altDark: 'Обзор в OctoWorkspace — тёмная тема',
  },
  {
    id: 'clients',
    label: 'Клиенты',
    light: clientLight,
    dark: clientDark,
    altLight: 'Карточка клиента в OctoWorkspace — светлая тема',
    altDark: 'Карточка клиента в OctoWorkspace — тёмная тема',
  },
  {
    id: 'projects',
    label: 'Проекты',
    light: projectsLight,
    dark: projectsDark,
    altLight: 'Список проектов в OctoWorkspace — светлая тема',
    altDark: 'Список проектов в OctoWorkspace — тёмная тема',
  },
  {
    id: 'tasks',
    label: 'Дела',
    light: tasksLight,
    dark: tasksDark,
    altLight: 'Доска дел в OctoWorkspace — светлая тема',
    altDark: 'Доска дел в OctoWorkspace — тёмная тема',
  },
  {
    id: 'planner',
    label: 'Планер',
    light: plannerLight,
    dark: plannerDark,
    altLight: 'Планирование проектов в OctoWorkspace — светлая тема',
    altDark: 'Планирование проектов в OctoWorkspace — тёмная тема',
  },
  {
    id: 'invoices',
    label: 'Счета',
    light: invoiceLight,
    dark: invoiceDark,
    altLight: 'Счёт в OctoWorkspace — светлая тема',
    altDark: 'Счёт в OctoWorkspace — тёмная тема',
  },
]

const defaultPreviewId = previews[0].id
const highlights = [`v${getVersion()}`, 'бесплатно', 'офлайн']
---

<section class="relative isolate overflow-x-clip pt-16 sm:pt-24" data-dot-grid>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-dot-grid mask-b-from-40%">
    <canvas class="block size-full text-dot" data-dot-grid-canvas aria-hidden="true"></canvas>
  </div>

  <div class="mx-auto max-w-6xl space-y-6 px-5" data-reveal>
    <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-ink-3">
      {
        highlights.map((highlight, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && <span class="text-line-strong">/</span>}
            {index === 0 && <span class="size-1.5 rounded-full bg-tone-green" />}
            {highlight}
          </li>
        ))
      }
    </ul>

    <h1
      class="max-w-3xl font-mono text-4xl font-semibold tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl"
    >
      Бесплатное приложение для&nbsp;фрилансеров
    </h1>

    <p class="max-w-xl text-lg leading-relaxed text-ink-2">
      Клиенты, учёт времени, счета и акты. Всё на вашем компьютере, без облака и подписок.
    </p>

    <DownloadButtons class="items-start pt-2" />
  </div>

  <div class="relative mx-auto mt-14 max-w-6xl px-5 sm:mt-20" data-hero-screenshots data-reveal>
    <div class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 h-3/4 bg-glow"></div>

    <div class="mb-6 flex justify-center">
      <div
        class="scrollbar-none flex max-w-full gap-1 overflow-x-auto rounded-full bg-surface-inset p-1 shadow-hairline"
        role="group"
        aria-label="Превью экранов приложения"
      >
        {
          previews.map((preview) => (
            <button
              type="button"
              data-hero-tag={preview.id}
              aria-pressed={preview.id === defaultPreviewId ? 'true' : 'false'}
              class="inline-flex min-h-11 shrink-0 items-center rounded-full px-4 font-mono text-xs text-ink-2 transition-colors hover:text-ink aria-pressed:bg-surface-field aria-pressed:text-ink aria-pressed:shadow-btn focus-visible:outline-2 focus-visible:outline-ink"
            >
              {preview.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="grid">
      {
        previews.map((preview, index) => (
          <div
            data-hero-preview={preview.id}
            aria-hidden={preview.id === defaultPreviewId ? 'false' : 'true'}
            class="col-start-1 row-start-1 transition-opacity duration-300 aria-hidden:pointer-events-none aria-hidden:opacity-0"
          >
            <Image
              alt={preview.altLight}
              src={preview.light}
              width={preview.light.width}
              height={preview.light.height}
              sizes="(min-width: 1152px) 1152px, calc(100vw - 2.5rem)"
              quality={85}
              format="webp"
              loading={index === 0 ? 'eager' : 'lazy'}
              class="mx-auto block h-auto w-full dark:hidden"
            />
            <Image
              alt={preview.altDark}
              src={preview.dark}
              width={preview.dark.width}
              height={preview.dark.height}
              sizes="(min-width: 1152px) 1152px, calc(100vw - 2.5rem)"
              quality={85}
              format="webp"
              loading={index === 0 ? 'eager' : 'lazy'}
              class="mx-auto hidden h-auto w-full dark:block"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script src="../scripts/init-hero-screenshots.ts"></script>
<script src="../scripts/init-dot-grid.ts"></script>
