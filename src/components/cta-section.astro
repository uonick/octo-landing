---
import DownloadButtons from '@/components/download-buttons.astro'
---

<section id="download" class="mx-auto max-w-6xl scroll-mt-20 px-5">
  <div
    class="relative isolate overflow-hidden rounded-card bg-surface-elevated px-6 py-16 text-center shadow-raised sm:px-12 sm:py-20"
    data-dot-grid
    data-reveal
  >
    <div class="pointer-events-none absolute inset-0 -z-10 bg-dot-grid mask-t-from-0%">
      <canvas class="block size-full text-dot" data-dot-grid-canvas aria-hidden="true"></canvas>
    </div>
    <div class="pointer-events-none absolute inset-x-0 -top-1/2 -z-10 h-full bg-glow"></div>

    <h2 class="mx-auto max-w-lg font-mono text-2xl font-semibold tracking-tight text-balance text-ink sm:text-3xl">
      Скачайте бесплатно
    </h2>
    <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-ink-2">
      Счета, часы и заметки только на вашем компьютере. Работает без интернета.
    </p>
    <DownloadButtons class="mt-8 items-center" />
  </div>
</section>

<script src="../scripts/init-dot-grid.ts"></script>
