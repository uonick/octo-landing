---
import GithubIcon from '@/components/github-icon.astro'
import PlatformIcon from '@/components/platform-icon.astro'
import { getDownloadLinks, getVersion } from '@/lib/download-links'
import {
  buildPrimaryButtonLabel,
  DEFAULT_PLATFORM,
  getSecondaryDownloadLinks,
  PLATFORMS,
} from '@/lib/download-platform'

type Props = {
  class?: string
}

const { class: className } = Astro.props

const version = getVersion()
const downloadLinks = getDownloadLinks()
---

<div class:list={['flex flex-col gap-4', className]}>
  <div class="flex flex-wrap items-center gap-3">
    {
      PLATFORMS.map((platform) => (
        <a
          data-download-platform={platform}
          hidden={platform !== DEFAULT_PLATFORM}
          href={downloadLinks[platform]}
          aria-label={buildPrimaryButtonLabel(version, platform)}
          class="inline-flex h-11 items-center gap-2.5 rounded-full bg-ink px-6 text-sm font-medium text-surface-page transition-opacity hover:opacity-90 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          <PlatformIcon platform={platform} />
          Скачать
        </a>
      ))
    }
    <a
      href="https://github.com/uonick/octo-workspace"
      target="_blank"
      rel="noreferrer"
      class="inline-flex h-11 items-center gap-2 rounded-full bg-surface-elevated px-5 text-sm font-medium text-ink shadow-btn transition-colors hover:bg-surface-hover active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      <GithubIcon />
      GitHub
    </a>
  </div>

  {
    PLATFORMS.map((platform) => {
      const secondaryLinks = getSecondaryDownloadLinks(platform, downloadLinks)
      return (
        <p
          data-download-platform={platform}
          hidden={platform !== DEFAULT_PLATFORM}
          class="font-mono text-xs text-ink-3"
        >
          а&nbsp;также{' '}
          {secondaryLinks.map((link, index) => (
            <>
              {index > 0 && (index === secondaryLinks.length - 1 ? ' и ' : ', ')}
              <a
                href={link.href}
                class="text-ink-2 underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink hover:decoration-ink-3"
                {...(link.key === 'appStore' ? { target: '_blank', rel: 'noreferrer' } : {})}
              >
                {link.label}
              </a>
            </>
          ))}
        </p>
      )
    })
  }
</div>

<script src="../scripts/init-download-buttons.ts"></script>
