---
import SectionHeading from '@/components/section-heading.astro'
import ToneChip from '@/components/tone-chip.astro'
import { toneAt } from '@/lib/tone'

type FaqItem = {
  question: string
  answer: string
}

const faqs: FaqItem[] = [
  {
    question: 'Где хранятся мои данные?',
    answer: 'На вашем компьютере, локально. Без облаков и синхронизации на чужие серверы',
  },
  {
    question: 'Приложение собирает данные?',
    answer:
      'Нет, приложение не собирает ваши данные. Подключение к интернету происходит при запросе обновлений раз в 30 минут и при старте приложения. Без интернета, проверку обновлений придется выполнять самостоятельно',
  },
  {
    question: 'Почему приложение бесплатное?',
    answer:
      'Проект начался как решение для одного пользователя, но затем мы решили делиться им бесплатно с широкой аудиторией. Наша цель: сделать его доступным для всех',
  },
  {
    question: 'Приложению можно доверять?',
    answer:
      'Да, каждая версия приложения проходит проверку от Apple (для компьютеров с macOS). Вы также можете самостоятельно загрузить её на VirusTotal для дополнительной проверки. Наша цель: обеспечить вам безопасность и надежность',
  },
  {
    question: 'Планируется ли сделать его платным?',
    answer:
      'Нет, такие планы отсутствуют. Приложение изначально создавалось с учетом бесплатного доступа для пользователей',
  },
  {
    question: 'Для кого подойдет приложение?',
    answer:
      'Для фрилансеров, самозанятых, дизайнеров и разработчиков. Приложение для работы фрилансером: учёт времени, счета и акты, клиенты, оплаты',
  },
]
---

<section id="faqs" class="mx-auto max-w-6xl scroll-mt-20 px-5">
  <div class="grid gap-10 lg:grid-cols-5 lg:gap-16">
    <div class="lg:col-span-2">
      <div class="lg:sticky lg:top-24">
        <SectionHeading eyebrow="FAQ" title="Вопросы и ответы">
          Не нашли ответ — спросите на{' '}
          <a
            href="https://github.com/uonick/octo-workspace/issues"
            class="text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink-3"
          >
            GitHub
          </a>
        </SectionHeading>
      </div>
    </div>

    <ol class="divide-y divide-line border-y border-line lg:col-span-3" data-reveal>
      {
        faqs.map((faq, index) => (
          <li class="flex gap-4 py-6">
            <ToneChip tone={toneAt(index)}>{String(index + 1).padStart(2, '0')}</ToneChip>
            <div class="min-w-0 space-y-2">
              <h3 class="text-base font-semibold text-ink">{faq.question}</h3>
              <p class="text-sm leading-relaxed text-ink-2">{faq.answer}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
