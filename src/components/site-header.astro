---
import { Image } from 'astro:assets'
import appIcon from '@/assets/images/app-icon.png'
import GithubIcon from '@/components/github-icon.astro'

const navigation = [
  { href: '/#audience', label: 'Для кого' },
  { href: '/#features', label: 'Возможности' },
  { href: '/#faqs', label: 'Вопросы' },
]
---

<header class="sticky top-0 z-50 border-b border-line bg-surface-page/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-5">
    <a href="/" class="flex min-h-11 items-center gap-2.5 text-ink">
      <Image
        src={appIcon}
        alt=""
        width={24}
        height={24}
        quality={90}
        format="webp"
        loading="eager"
        class="size-6 rounded-md"
      />
      <span class="font-mono text-sm font-semibold tracking-tight">OctoWorkspace</span>
    </a>

    <div class="flex items-center gap-1 font-mono text-xs text-ink-2">
      <ul class="hidden items-center md:flex">
        {
          navigation.map((item) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center px-3 transition-colors hover:text-ink"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="mx-2 hidden h-4 w-px bg-line md:block"></span>

      <a
        class="hidden min-h-11 items-center gap-2 px-3 transition-colors hover:text-ink sm:inline-flex"
        href="https://github.com/uonick/octo-workspace"
        target="_blank"
        rel="noreferrer"
      >
        <GithubIcon />
        GitHub
      </a>

      <a href="/#download" class="group inline-flex min-h-11 items-center pl-2">
        <span
          class="inline-flex h-8 items-center rounded-full bg-ink px-4 font-medium text-surface-page transition-opacity group-hover:opacity-90"
        >
          Скачать
        </span>
      </a>
    </div>
  </nav>
</header>
