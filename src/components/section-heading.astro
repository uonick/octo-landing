---
type Props = {
  eyebrow: string
  title: string
}

const { eyebrow, title } = Astro.props
---

<div class="max-w-xl space-y-3" data-reveal>
  <p class="font-mono text-xs uppercase tracking-widest text-ink-3">{eyebrow}</p>
  <h2 class="font-mono text-2xl font-semibold tracking-tight text-balance text-ink sm:text-3xl">
    {title}
  </h2>
  <p class="text-base leading-relaxed text-ink-2">
    <slot />
  </p>
</div>
