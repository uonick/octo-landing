---
import SectionHeading from '@/components/section-heading.astro'
import ToneChip from '@/components/tone-chip.astro'
import { toneAt } from '@/lib/tone'

const roles = [
  'Графические и веб-дизайнеры',
  'UX/UI-специалисты',
  'Разработчики на фрилансе',
  'Копирайтеры и контент-мейкеры',
  'Маркетологи и SMM',
  'Небольшие студии 2–5 человек'
]
---

<section id="audience" class="mx-auto max-w-6xl scroll-mt-20 px-5">
  <div class="grid gap-10 lg:grid-cols-5 lg:gap-16">
    <div class="lg:col-span-2">
      <SectionHeading eyebrow="Для кого" title="Для тех, кто работает с клиентами напрямую">
        Фрилансеры и небольшие студии. Если вы ведёте проекты, выставляете счета и согласуете работу
        по этапам — это про вас.
      </SectionHeading>
    </div>

    <div class="self-start lg:col-span-3" data-reveal>
      <ul class="grid gap-px overflow-hidden rounded-card bg-line shadow-hairline sm:grid-cols-2">
        {
          roles.map((role, index) => (
            <li class="flex min-h-16 items-center gap-3 bg-surface-elevated px-4 py-3 transition-colors hover:bg-surface-hover">
              <ToneChip tone={toneAt(index)}>
                <svg viewBox="0 0 20 20" fill="currentColor" class="size-3.5" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                    clip-rule="evenodd"
                  />
                </svg>
              </ToneChip>
              <span class="text-sm font-medium text-ink">{role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
