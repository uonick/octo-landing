---
import { Image } from 'astro:assets'
import clientDark from '@/assets/images/client-dark.png'
import clientLight from '@/assets/images/client-light.png'
import projectsDark from '@/assets/images/projects-dark.png'
import projectsLight from '@/assets/images/projects-light.png'
import notesDark from '@/assets/images/notes-dark.png'
import notesLight from '@/assets/images/notes-light.png'
import invoiceDark from '@/assets/images/invoice-dark.png'
import invoiceLight from '@/assets/images/invoice-light.png'
import DownloadButtons from '@/components/download-buttons.astro'

type Preview = {
  id: string
  label: string
  light: ImageMetadata
  dark: ImageMetadata
  altLight: string
  altDark: string
}

const previews: Preview[] = [
  {
    id: 'clients',
    label: 'Клиенты',
    light: clientLight,
    dark: clientDark,
    altLight: 'Карточка клиента в OctoWorkspace — светлая тема',
    altDark: 'Карточка клиента в OctoWorkspace — тёмная тема',
  },
  {
    id: 'projects',
    label: 'Проекты',
    light: projectsLight,
    dark: projectsDark,
    altLight: 'Список проектов в OctoWorkspace — светлая тема',
    altDark: 'Список проектов в OctoWorkspace — тёмная тема',
  },
  {
    id: 'notes',
    label: 'Дела',
    light: notesLight,
    dark: notesDark,
    altLight: 'Доска дел в OctoWorkspace — светлая тема',
    altDark: 'Доска дел в OctoWorkspace — тёмная тема',
  },
  {
    id: 'invoices',
    label: 'Счета',
    light: invoiceLight,
    dark: invoiceDark,
    altLight: 'Счёт в OctoWorkspace — светлая тема',
    altDark: 'Счёт в OctoWorkspace — тёмная тема',
  },
]

const defaultPreviewId = previews[0].id

const screenshotClass =
  'mx-auto block h-auto w-full max-w-none border-0 bg-transparent object-contain shadow-none outline-none'

const tagBaseClass =
  'rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-canvas'
---

<section class="relative overflow-x-clip pt-20 pb-4 sm:pt-28">
  <div class="pointer-events-none absolute inset-0 -z-10 mesh-bg"></div>

  <div
    class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full bg-accent-coral/20 blur-3xl animate-blob"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-10 -right-16 h-64 w-64 rounded-full bg-accent-mint/20 blur-3xl animate-blob animation-delay-300"
  >
  </div>
  <div
    class="pointer-events-none absolute top-1/2 -left-10 h-56 w-56 rounded-full bg-accent-sky/15 blur-3xl animate-blob animation-delay-500"
  >
  </div>

  <div class="container mx-auto max-w-6xl px-5 xl:px-0">
    <div class="mx-auto max-w-2xl animate-fade-up space-y-7 text-center">
      <span
        class="mx-auto inline-flex items-center gap-2 rounded-full bg-accent-mint/15 px-4 py-1.5 text-xs font-semibold text-accent-mint"
      >
        <span class="h-2 w-2 rounded-full bg-accent-mint animate-glow"></span>
        Бесплатно · офлайн · десктоп
      </span>

      <h1
        class="text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl"
        style="letter-spacing: -1.5px;"
      >
        Бесплатное приложение для&nbsp;<span class="text-gradient-brand">фрилансеров</span>
      </h1>

      <p class="mx-auto max-w-lg text-base leading-relaxed text-ink-subtle">
        Клиенты, учёт времени, счета и акты. Всё на вашем компьютере, без облака и подписок.
      </p>

      <div class="flex justify-center">
        <DownloadButtons />
      </div>
    </div>
  </div>

  <div class="relative mt-16 w-full px-5 sm:mt-20 sm:px-8" data-hero-screenshots>
    <div
      class="mx-auto mb-5 flex w-full max-w-6xl flex-wrap items-center justify-center gap-2 animate-fade-up animation-delay-150"
      role="group"
      aria-label="Превью экранов приложения"
    >
      {
        previews.map((preview) => {
          const isActive = preview.id === defaultPreviewId
          return (
            <button
              type="button"
              data-hero-tag={preview.id}
              aria-pressed={isActive ? 'true' : 'false'}
              class:list={[
                tagBaseClass,
                isActive
                  ? 'bg-brand text-white shadow-[0_4px_16px_-4px_rgba(94,106,210,0.55)]'
                  : 'bg-surface-2 text-ink-subtle hover:bg-surface-3 hover:text-ink',
              ]}
            >
              {preview.label}
            </button>
          )
        })
      }
    </div>

    <div class="mx-auto grid w-full max-w-6xl animate-fade-up animation-delay-300">
      {
        previews.map((preview, index) => {
          const isActive = preview.id === defaultPreviewId
          return (
            <div
              data-hero-preview={preview.id}
              class:list={[
                'col-start-1 row-start-1 transition-opacity duration-300',
                isActive
                  ? 'opacity-100 pointer-events-auto'
                  : 'opacity-0 pointer-events-none',
              ]}
              aria-hidden={isActive ? undefined : 'true'}
            >
              <Image
                alt={preview.altLight}
                src={preview.light}
                width={preview.light.width}
                height={preview.light.height}
                sizes="(min-width: 1152px) 1152px, calc(100vw - 2.5rem)"
                quality={85}
                format="webp"
                loading={index === 0 ? 'eager' : 'lazy'}
                class:list={[screenshotClass, 'dark:hidden']}
              />
              <Image
                alt={preview.altDark}
                src={preview.dark}
                width={preview.dark.width}
                height={preview.dark.height}
                sizes="(min-width: 1152px) 1152px, calc(100vw - 2.5rem)"
                quality={85}
                format="webp"
                loading={index === 0 ? 'eager' : 'lazy'}
                class:list={[screenshotClass, 'hidden dark:block']}
              />
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script src="../scripts/init-hero-screenshots.ts"></script>
